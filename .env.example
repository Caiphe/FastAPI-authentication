# Local development configuration. Copy to .env:   cp .env.example .env
#
# Every value here is safe ONLY for local development. Lines marked [PRODUCTION]
# must be changed for any shared or production deployment; with
# AUTH_ENVIRONMENT=production the application refuses to start until they are.

# --- Application -------------------------------------------------------------
# development | test | production. Production enables the strict validators.
AUTH_ENVIRONMENT=development
AUTH_APP_NAME=Authentication API
AUTH_API_V1_PREFIX=/api/v1
# [PRODUCTION] must be false: debug mode returns tracebacks to clients.
AUTH_DEBUG=true
# DEBUG | INFO | WARNING | ERROR for the application's own loggers.
AUTH_LOG_LEVEL=INFO
# Unset: interactive docs on everywhere except production. true/false to force.
# AUTH_DOCS_ENABLED=

# --- Tokens --------------------------------------------------------------------
# [PRODUCTION] Generate your own:  python -c 'import secrets; print(secrets.token_urlsafe(48))'
# This placeholder is public; production rejects it, and anyone can forge tokens with it.
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- Local infrastructure (read by compose.yaml) -------------------------------
# POSTGRES_* apply only when the PostgreSQL volume is first created.
POSTGRES_DB=auth
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth-local-only
# Change both ports (and the URLs below) if something else already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Connection URLs -----------------------------------------------------------
# [PRODUCTION] Point at managed services with real credentials (rediss:// for TLS).
AUTH_DATABASE_URL=postgresql+psycopg://auth:auth-local-only@localhost:5432/auth
AUTH_REDIS_URL=redis://localhost:6379/0

# --- HTTP ----------------------------------------------------------------------
# Browser origins allowed to call the API with cookies, comma-separated, no paths.
# Empty disables CORS (same-origin frontends need nothing here).
# [PRODUCTION] https origins only, e.g. https://app.example.com
AUTH_CORS_ALLOWED_ORIGINS=
# Accepted Host headers, comma-separated; *.example.com allows subdomains.
# [PRODUCTION] must list the API's hostnames; "*" is rejected.
AUTH_TRUSTED_HOSTS=*

# --- Refresh-token cookie ------------------------------------------------------
# Defaults: host-only, Secure, HttpOnly, SameSite=Lax, scoped to /api/v1/auth.
AUTH_REFRESH_COOKIE_NAME=refresh_token
# Must cover the auth routes; update it if you change AUTH_API_V1_PREFIX.
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# Leave unset for a host-only cookie. Set only to share it across subdomains.
# AUTH_REFRESH_COOKIE_DOMAIN=example.com
# [PRODUCTION] must be true. false is allowed only for plain-HTTP local testing;
# browsers already accept Secure cookies on http://localhost.
AUTH_REFRESH_COOKIE_SECURE=true
# lax | strict | none. none requires Secure and a CORS review.
AUTH_REFRESH_COOKIE_SAMESITE=lax

# --- Email ---------------------------------------------------------------------
# [PRODUCTION] https URL of the frontend that hosts the verify/reset pages.
AUTH_FRONTEND_BASE_URL=http://localhost:3000
AUTH_FRONTEND_VERIFY_EMAIL_PATH=/verify-email
AUTH_FRONTEND_RESET_PASSWORD_PATH=/reset-password
# Only "development" exists: it logs metadata and writes .eml files, it does not send.
# [PRODUCTION] add a real provider adapter before going live.
AUTH_EMAIL_PROVIDER=development
AUTH_EMAIL_FROM_ADDRESS=Authentication API <no-reply@localhost>
# Development only: full messages (including live links) are written here. Git-ignored.
AUTH_EMAIL_OUTBOX_DIR=.outbox
AUTH_EMAIL_TASK_MAX_RETRIES=5

# --- Background jobs -----------------------------------------------------------
# true runs tasks inside the API process (no worker needed). [PRODUCTION] must be false.
AUTH_CELERY_TASK_ALWAYS_EAGER=false
